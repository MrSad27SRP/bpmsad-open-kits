<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="urn:bpmsad:dispute">
  <bpmn:process id="Dispute" name="مغایرت تراکنش" isExecutable="false">
    <bpmn:startEvent id='Start' name='دریافت'/>
    <bpmn:parallelGateway id='Fork' name=''/>
    <bpmn:userTask id='Evidence' name='گردآوری شواهد'/>
    <bpmn:task id='Slot' name='رزرو نوبت'/>
    <bpmn:parallelGateway id='Join' name=''/>
    <bpmn:userTask id='Review' name='ثبت تصمیم'/>
    <bpmn:task id='Notify' name='ابلاغ نتیجه'/>
    <bpmn:endEvent id='End' name='بستن'/>
    <bpmn:subProcess id="SlaMonitor" triggeredByEvent="true" name="پایش موعد تصمیم">
      <bpmn:startEvent id="Deadline" isInterrupting="false">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT72H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:userTask id="Escalate" name="بررسی ارجاع در صورت نبود تصمیم"/>
      <bpmn:endEvent id="EscalationEnd"/>
      <bpmn:sequenceFlow id="Sla1" sourceRef="Deadline" targetRef="Escalate"/>
      <bpmn:sequenceFlow id="Sla2" sourceRef="Escalate" targetRef="EscalationEnd"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id='F0' sourceRef='Start' targetRef='Fork'/>
    <bpmn:sequenceFlow id='F1' sourceRef='Fork' targetRef='Evidence'/>
    <bpmn:sequenceFlow id='F2' sourceRef='Fork' targetRef='Slot'/>
    <bpmn:sequenceFlow id='F3' sourceRef='Evidence' targetRef='Join'/>
    <bpmn:sequenceFlow id='F4' sourceRef='Slot' targetRef='Join'/>
    <bpmn:sequenceFlow id='F5' sourceRef='Join' targetRef='Review'/>
    <bpmn:sequenceFlow id='F6' sourceRef='Review' targetRef='Notify'/>
    <bpmn:sequenceFlow id='F7' sourceRef='Notify' targetRef='End'/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Dispute">
      <bpmndi:BPMNShape id='Start_di' bpmnElement='Start'><dc:Bounds x='40' y='130' width='36' height='36'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='Fork_di' bpmnElement='Fork'><dc:Bounds x='115' y='123' width='50' height='50'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='Evidence_di' bpmnElement='Evidence'><dc:Bounds x='205' y='55' width='120' height='65'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='Slot_di' bpmnElement='Slot'><dc:Bounds x='205' y='175' width='120' height='65'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='Join_di' bpmnElement='Join'><dc:Bounds x='365' y='123' width='50' height='50'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='Review_di' bpmnElement='Review'><dc:Bounds x='455' y='115' width='120' height='65'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='Notify_di' bpmnElement='Notify'><dc:Bounds x='615' y='115' width='120' height='65'/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id='End_di' bpmnElement='End'><dc:Bounds x='775' y='130' width='36' height='36'/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id='F0_di' bpmnElement='F0'><di:waypoint x='76' y='148'/><di:waypoint x='115' y='148'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F1_di' bpmnElement='F1'><di:waypoint x='140' y='123'/><di:waypoint x='140' y='88'/><di:waypoint x='205' y='88'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F2_di' bpmnElement='F2'><di:waypoint x='140' y='173'/><di:waypoint x='140' y='208'/><di:waypoint x='205' y='208'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F3_di' bpmnElement='F3'><di:waypoint x='325' y='88'/><di:waypoint x='390' y='88'/><di:waypoint x='390' y='123'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F4_di' bpmnElement='F4'><di:waypoint x='325' y='208'/><di:waypoint x='390' y='208'/><di:waypoint x='390' y='173'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F5_di' bpmnElement='F5'><di:waypoint x='415' y='148'/><di:waypoint x='455' y='148'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F6_di' bpmnElement='F6'><di:waypoint x='575' y='148'/><di:waypoint x='615' y='148'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id='F7_di' bpmnElement='F7'><di:waypoint x='735' y='148'/><di:waypoint x='775' y='148'/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="SlaMonitor_di" bpmnElement="SlaMonitor" isExpanded="true"><dc:Bounds x="410" y="275" width="400" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Deadline_di" bpmnElement="Deadline"><dc:Bounds x="440" y="330" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalate_di" bpmnElement="Escalate"><dc:Bounds x="520" y="315" width="150" height="66"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EscalationEnd_di" bpmnElement="EscalationEnd"><dc:Bounds x="720" y="330" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Sla1_di" bpmnElement="Sla1"><di:waypoint x="476" y="348"/><di:waypoint x="520" y="348"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Sla2_di" bpmnElement="Sla2"><di:waypoint x="670" y="348"/><di:waypoint x="720" y="348"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
